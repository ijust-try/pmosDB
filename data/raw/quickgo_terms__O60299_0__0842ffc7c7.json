   {
    "id": "GO:0061001",
    "isObsolete": false,
    "name": "regulation of dendritic spine morphogenesis",
    "definition": {
     "text": "Any process that modulates the rate, frequency, or extent of dendritic spine morphogenesis, the process in which the anatomical structures of a dendritic spine are generated and organized. A dendritic spine is a protrusion from a dendrite and a specialized subcellular compartment involved in synaptic transmission."
    },
