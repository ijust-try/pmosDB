  "summation": [
   {
    "dbId": 349475,
    "displayName": "COP1 is one of several  E3 ubiquitin ligases responsible for...",
    "text": "COP1 is one of several  E3 ubiquitin ligases responsible for the tight regulation of  p53 abundance.  Following DNA damage, COP1 dissociates from p53 and  is inactivated by autodegradation via a pathway involving ATM phosphorylation of  COP1 on Ser(387),  autoubiquitination and proteasome mediated degradation. Destruction of COP1 results in abrogation of the ubiquitination and degradation of p53 (Dornan et al., 2006).",
    "className": "Summation",
    "schemaClass": "Summation"
