  "summation": [
   {
    "dbId": 6811633,
    "displayName": "Under conditions of cellular stress, nuclear levels of phosp...",
    "text": "Under conditions of cellular stress, nuclear levels of phosphatidylinositol-5-phosphate (PI5P) increase and, through interaction with ING2, result in nuclear retention/accumulation of ING2. ING2 binds TP53 (p53) and recruits histone acetyltransferase EP300 (p300) to TP53, leading to TP53 acetylation. Increased nuclear PI5P levels positively regulate TP53 acetylation (Ciruela et al. 2000, Gozani et al. 2003, Jones et al. 2006, Zou et al. 2007, Bultsma et al. 2010).",
    "className": "Summation",
