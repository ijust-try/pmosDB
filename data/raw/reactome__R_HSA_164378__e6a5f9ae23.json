  "summation": [
   {
    "dbId": 164390,
    "displayName": "Adenylate cyclase catalyses the synthesis of cyclic AMP (cAM...",
    "text": "Adenylate cyclase catalyses the synthesis of cyclic AMP (cAMP) from ATP. In the absence of cAMP, protein kinase A (PKA) exists as inactive tetramers of two catalytic subunits and two regulatory subunits. cAMP binding to PKA tetramers causes them to dissociate and release their catalytic subunits as active monomers. Four isoforms of the regulatory subunit are known, that differ in their tissue specificity and functional characteristics, but the specific isoform activated in response to glucagon signaling has not yet been identified.",
    "className": "Summation",
    "schemaClass": "Summation"
